{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "db:generate": {
      "outputs": ["node_modules/.prisma/client/**"]
    },
    "db:push": {},
    "db:migrate": {},
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    }
  },
  "globalEnv": ["DATABASE_URL", "REDIS_URL", "JWT_SECRET"],
  "globalDependencies": [".env*"]
}